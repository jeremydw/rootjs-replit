modules = ["nodejs-20", "web", "go-1.21"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "starter-dev-server"

[[workflows.workflow]]
name = "starter-dev-server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd examples/starter && PORT=5000 pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 5001
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 5010
externalPort = 3000

[[ports]]
localPort = 5011
externalPort = 3003

[[ports]]
localPort = 33635
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd examples/starter && PORT=5000 pnpm run start"]
build = ["bash", "-c", "cd examples/starter && pnpm run build"]
